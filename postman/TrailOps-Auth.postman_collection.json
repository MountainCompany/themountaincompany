{
  "info": {
    "name": "TrailOps — Admin Auth (Stage 2)",
    "description": "Login/refresh/logout/me for the JWT service. See jwt-service.md and docs/IMPLEMENTATION_PLAN.md §5. Import this alongside a 'TrailOps Local' environment with a `base_url` variable (e.g. http://localhost:8000).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "http://localhost:8000" },
    { "key": "access_token", "value": "" },
    { "key": "refresh_token", "value": "" }
  ],
  "item": [
    {
      "name": "Login",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": { "raw": "{{base_url}}/api/v1/auth/login", "host": ["{{base_url}}"], "path": ["api", "v1", "auth", "login"] },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"owner@example.com\",\n  \"password\": \"changeme\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "if (pm.response.code === 200) {",
              "    const body = pm.response.json();",
              "    pm.collectionVariables.set('access_token', body.access_token);",
              "    pm.collectionVariables.set('refresh_token', body.refresh_token);",
              "    pm.test('got a token pair', () => pm.expect(body.access_token).to.be.a('string'));",
              "} else {",
              "    pm.test('login failed: ' + pm.response.code, () => pm.expect.fail(pm.response.text()));",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "Me (authenticated)",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }],
        "url": { "raw": "{{base_url}}/api/v1/auth/me", "host": ["{{base_url}}"], "path": ["api", "v1", "auth", "me"] }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('status is 200', () => pm.response.to.have.status(200));",
              "pm.test('role is present', () => pm.expect(pm.response.json().role).to.be.a('string'));"
            ]
          }
        }
      ]
    },
    {
      "name": "Refresh",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": { "raw": "{{base_url}}/api/v1/auth/refresh", "host": ["{{base_url}}"], "path": ["api", "v1", "auth", "refresh"] },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"refresh_token\": \"{{refresh_token}}\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "if (pm.response.code === 200) {",
              "    const body = pm.response.json();",
              "    pm.collectionVariables.set('access_token', body.access_token);",
              "    pm.collectionVariables.set('refresh_token', body.refresh_token);",
              "    pm.test('rotated to a new pair', () => pm.expect(body.access_token).to.be.a('string'));",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "Logout",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": { "raw": "{{base_url}}/api/v1/auth/logout", "host": ["{{base_url}}"], "path": ["api", "v1", "auth", "logout"] },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"refresh_token\": \"{{refresh_token}}\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": { "exec": ["pm.test('status is 204', () => pm.response.to.have.status(204));"] }
        }
      ]
    },
    {
      "name": "Me — after logout (expect 401)",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }],
        "url": { "raw": "{{base_url}}/api/v1/auth/me", "host": ["{{base_url}}"], "path": ["api", "v1", "auth", "me"] }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "// access tokens are stateless (jwt-service.md §2.4) so this still succeeds until",
              "// the 15-minute TTL expires — logout only revoked the refresh token. Expected.",
              "pm.test('access token still valid until its own TTL expires', () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    }
  ]
}
