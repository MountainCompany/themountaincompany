# Copy to .env for local dev. Never commit .env — see BACKEND_REQUIREMENTS.md §7
# and jwt-service.md §9.2 ("no secrets in the repo").

# development | staging | production
ENVIRONMENT=development

# Startup schema bootstrap (jwt-service.md §7.5). Dev stays false — migrations are
# applied by hand with `alembic upgrade head`, same as every other model in the
# project. Prod sets this true so the app creates its own schema on first boot.
AUTO_MIGRATE=false

# Local dev: point at a local/Docker Postgres. Prod: the Supabase prod project's
# connection string (direct connection, not the pgbouncer pooler — see §9.4),
# injected via Railway's Variables store, never written here.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/trailops_dev

# Local dev: local/Docker Redis. Prod: the Upstash connection string.
REDIS_URL=redis://localhost:6379/0

# HS256 signing secret (jwt-service.md §0, §9.2). Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=changeme

# Optional — set during a secret-rotation window only (§2.5). Verification falls
# back to this key if the current JWT_SECRET_KEY fails; signing always uses current.
JWT_SECRET_KEY_PREVIOUS=

# HMAC pepper for OTP hashing (§4.2) — separate secret from JWT_SECRET_KEY.
OTP_HASH_PEPPER=changeme

# Read once by app/db/seed.py (Stage 2) to create the first `owner` admin account
# if none exists yet. Shape only here — real values live in the deploy secret store.
INITIAL_ADMIN_EMAIL=owner@example.com
INITIAL_ADMIN_PASSWORD=changeme
